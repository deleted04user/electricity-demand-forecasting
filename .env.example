# Backend configuration. Copy to .env, then run:
# python -m uvicorn backend.main:app --env-file .env --reload --port 8000
# Restart the backend after changing these settings. Do not commit real secrets.

ELECTRICITY_TIMEZONE=Africa/Casablanca
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave optional paths unset to use the bundled synthetic demonstration data.
# Use forward slashes for Windows paths, and quote paths containing spaces.
# ELECTRICITY_DATA_PATH="C:/data/verified_hourly.csv"
# WEATHER_FORECAST_PATH="C:/data/future_weather.csv"
# VERIFIED_EVENTS_PATH="C:/data/verified_events.csv"

# Compose host ports. These do not change Vite or Uvicorn's local dev ports.
# API_PORT=8000
# FRONTEND_PORT=8080
