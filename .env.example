# Backend configuration. Copy to .env, then run:
# python -m uvicorn backend.main:app --env-file .env --reload --port 8000
# Restart the backend after changing these settings. Do not commit real secrets.

ELECTRICITY_TIMEZONE=Africa/Casablanca
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default demand input is the bundled synthetic demonstration data.
# Relative paths assume commands are run from the repository root.
# Use forward slashes for Windows paths, and quote paths containing spaces.
ELECTRICITY_DATA_PATH=data/electricity_demand_2025.xlsx
# Empty optional paths disable future-weather and verified-event overrides.
WEATHER_FORECAST_PATH=
VERIFIED_EVENTS_PATH=

# Offline research enforces these privacy settings in its worker as well.
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_ENABLE_OTLP_EXPORTER=false
MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING=false
MLFLOW_DISABLE_AGENT_HINT=1

# Browser test process settings; export these in the shell running Playwright.
E2E_BASE_URL=http://127.0.0.1:8080
# GitHub Actions sets CI=true. Leave empty for local runs (do not use CI=false:
# any non-empty string enables Playwright's CI mode).
CI=

# Compose host ports. These do not change Vite or Uvicorn's local dev ports.
API_PORT=8000
FRONTEND_PORT=8080
