# Preserve measured report bytes: reproduction_check.json records their SHA256.
experiments/reports/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Research input hashes must survive Windows core.autocrlf checkouts.
/configs/experiments.json text eol=lf
/requirements*.lock.txt text eol=lf
/requirements-research.txt text eol=lf
/pyproject.toml text eol=lf
/uv.lock text eol=lf
